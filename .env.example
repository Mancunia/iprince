# Local development: run `npx supabase start && npm run db:env` to generate .env.local.
# Production: copy these from the Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Shared secret Vercel Cron sends to /api/cron/cleanup (min 32 chars: openssl rand -hex 32).
CRON_SECRET=
# Optional. CookieScript banner ID: the <id> in cdn.cookie-script.com/s/<id>.js. Required before tawk.to can be switched on.
COOKIESCRIPT_ID=
# Optional. tawk.to chat: the two parts of embed.tawk.to/<property>/<widget>. Choose WhatsApp or tawk.to under Admin → Settings.
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=
# Optional. Google Analytics 4 measurement ID (G-XXXXXXXX). Only loads after CookieScript "performance" consent, so COOKIESCRIPT_ID is required too.
GA_MEASUREMENT_ID=
# Optional. Google Search Console HTML-tag verification: the content="..." value only.
GOOGLE_SITE_VERIFICATION=
# Optional. Staff notification for new employer enquiries and contact messages, sent via Resend (resend.com).
# Leave any of the three empty to turn notifications off (local dev, e2e). FROM must use a domain verified in Resend.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
