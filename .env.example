# Supabase Configuration
# Find these in your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api

# Public URL of your Supabase project instance
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anonymous key for client-side queries (safe to expose, protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key for admin / background operations bypassing RLS (SERVER-ONLY, NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
