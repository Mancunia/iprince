# Local development: run `npx supabase start && npm run db:env` to generate .env.local.
# Production: copy these from the Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Shared secret Vercel Cron sends to /api/cron/cleanup-applications (min 32 chars: openssl rand -hex 32).
CRON_SECRET=
# Optional. CookieScript banner ID: the <id> in cdn.cookie-script.com/s/<id>.js. Required before tawk.to can be switched on.
COOKIESCRIPT_ID=
# Optional. tawk.to chat: the two parts of embed.tawk.to/<property>/<widget>. Choose WhatsApp or tawk.to under Admin → Settings.
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=
